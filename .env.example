# --- Turso ---
# El cliente detecta automáticamente si la URL es "file:..." (local) o "libsql://..." (Turso).
# Para producción:
#   1. turso db create natural-pharma
#   2. turso db show natural-pharma --url   -> TURSO_DATABASE_URL
#   3. turso auth tokens create natural-pharma -> TURSO_AUTH_TOKEN
# Para desarrollo local, dejá la URL file: y borrá el auth token.

# Producción (Turso):
# TURSO_DATABASE_URL=libsql://natural-pharma-xxx.turso.io
# TURSO_AUTH_TOKEN=...

# Desarrollo local (SQLite file):
TURSO_DATABASE_URL=file:./data/products.db

# --- Auth ---
# Generá con: openssl rand -hex 32
JWT_SECRET=

# Credenciales del primer admin. Se usan solo en el primer arranque
# del setup script (cuando la tabla admins está vacía). Después podés
# cambiarlas editando la DB.
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=

# --- WhatsApp ---
# Número al que llegan los pedidos. Formato internacional sin '+' ni espacios.
# Ejemplo Bolivia: 59178945612
NEXT_PUBLIC_WHATSAPP_NUMBER=59178945612

# --- Site ---
# URL canónica del sitio. Usada en metadata Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000